# PostgreSQL connection string (Neon/Supabase free tier works)
DATABASE_URL=postgres://user:password@localhost:5432/feedback_analyzer

# OPTIONAL — leave empty for full mock mode (deterministic detection,
# phrasebook translation, lexicon sentiment, keyword themes).
# Set a key to switch translation/sentiment/themes to gpt-4o-mini.
OPENAI_API_KEY=

# Password used for the seeded dashboard users (scripts/setup.mjs)
SEED_PASSWORD=ChangeMe123!
